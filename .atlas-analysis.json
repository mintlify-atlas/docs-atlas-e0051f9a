  "keyFeatures": [
    "50+ accessible, headless components built exclusively on @base-ui/react primitives",
    "shadcn-style developer experience — components are copied into your project, you own the code",
    "Single shared portal system: Select inside Drawer, Toast inside Dialog, Combobox in overlays all compose safely",
    "Tailwind CSS v4 styling with CSS custom properties compatible with shadcn/ui theming tokens",
    "CLI tool (npx baseui-cn) for init, add, update, and list commands",
    "Works with Next.js, Vite, Remix, Astro, and any React 18+ project",
    "TypeScript-first with full type exports for all components"
  ],
  "publicApiSurface": [
    "npx baseui-cn init",
    "npx baseui-cn add [components...]",
    "npx baseui-cn update [components...]",
    "npx baseui-cn list",
    "Button (variant, size, loading)",
    "Dialog / DialogTrigger / DialogContent / DialogHeader / DialogFooter / DialogClose",
    "Drawer / DrawerTrigger / DrawerContent (side) / DrawerHeader / DrawerFooter / DrawerClose",
    "Select / SelectTrigger / SelectContent / SelectItem / SelectGroup",
    "Combobox / ComboboxInput / ComboboxContent / ComboboxItem / ComboboxChips",
    "ToastProvider (position, limit, toastManager) / useToast() / createToastManager()",
    "Tooltip / TooltipTrigger / TooltipContent / TooltipProvider",
    "Popover / PopoverTrigger / PopoverContent",
    "DropdownMenu / DropdownMenuTrigger / DropdownMenuContent / DropdownMenuItem",
    "AlertDialog / AlertDialogTrigger / AlertDialogContent",
    "Accordion / AccordionItem / AccordionTrigger / AccordionContent",
    "Tabs / TabsList / TabsTrigger / TabsContent",
    "Checkbox / CheckboxGroup / Switch / RadioGroup",
    "Input / Textarea / Field / NumberField / Slider",
    "Table / Breadcrumb / Pagination / NavigationMenu",
    "Badge / Avatar / Card / Skeleton / Spinner / Progress / Separator"
